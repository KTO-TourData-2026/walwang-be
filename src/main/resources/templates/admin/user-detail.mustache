{{> admin/_head}}
{{> admin/_nav}}
<main>
  <p><a href="/admin/users">← 회원 목록</a></p>
  {{#user}}
  <h1>{{nickname}}</h1>
  <dl class="facts">
    <dt>회원 ID</dt><dd><code>{{userId}}</code></dd>
    <dt>이메일</dt><dd>{{email}}</dd>
    <dt>가입일</dt><dd>{{joinedAt}}</dd>
  </dl>
  <p><a href="/admin/access-logs?targetUserId={{userId}}">이 회원의 정보를 조회한 기록 보기</a></p>

  <section>
    <h2>리뷰 <small>{{reviewTotal}}건</small></h2>
    <div class="table-wrap">
      <table class="compact">
        <tbody>
          {{#reviewStats}}<tr><td>{{label}}</td><td class="num">{{count}}</td></tr>{{/reviewStats}}
          {{^reviewStats}}<tr><td class="empty">리뷰가 없습니다.</td></tr>{{/reviewStats}}
        </tbody>
      </table>
    </div>
    <h3>최근 리뷰 <small>최대 10건</small></h3>
    <p class="meta">리뷰 본문과 사진은 표시하지 않습니다.</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>작성일</th><th>가게</th><th>크기</th><th>동반</th><th>노출 상태</th><th>구분</th></tr></thead>
        <tbody>
          {{#recentReviews}}
          <tr>
            <td class="nowrap">{{createdAt}}</td>
            <td>{{storeName}}</td>
            <td>{{dogSize}}</td>
            <td>{{dogAllowed}}</td>
            <td>{{status}}</td>
            <td>{{kind}}</td>
          </tr>
          {{/recentReviews}}
          {{^recentReviews}}<tr><td colspan="6" class="empty">리뷰가 없습니다.</td></tr>{{/recentReviews}}
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <h2>저장 <small>가게 {{savedStoreCount}}곳 · 코스 {{savedCourseCount}}개</small></h2>
    <h3>최근 저장 코스 <small>최대 10개</small></h3>
    <div class="table-wrap">
      <table>
        <thead><tr><th>저장일</th><th>제목</th><th>구분</th></tr></thead>
        <tbody>
          {{#recentCourses}}
          <tr><td class="nowrap">{{createdAt}}</td><td>{{title}}</td><td>{{kind}}</td></tr>
          {{/recentCourses}}
          {{^recentCourses}}<tr><td colspan="3" class="empty">저장한 코스가 없습니다.</td></tr>{{/recentCourses}}
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <h2>도장 <small>{{stampTotal}}장</small></h2>
    <div class="table-wrap">
      <table class="compact">
        <tbody>
          {{#stampStats}}<tr><td>{{label}}</td><td class="num">{{count}}</td></tr>{{/stampStats}}
          {{^stampStats}}<tr><td class="empty">도장이 없습니다.</td></tr>{{/stampStats}}
        </tbody>
      </table>
    </div>
  </section>
  <details class="danger-zone">
    <summary>이용계약 해지</summary>
    <p class="alert">되돌릴 수 없습니다. 실행하면 아래가 모두 사라집니다.</p>
    <ul>
      <li>회원 계정과 약관 동의 이력</li>
      <li>작성한 리뷰 {{reviewTotal}}건과 그 사진 파일, 받은 신고 이력</li>
      <li>저장한 가게 {{savedStoreCount}}곳 · 코스 {{savedCourseCount}}개</li>
      <li>여권과 도장 {{stampTotal}}장, 도장 이미지 파일</li>
    </ul>
    <p class="meta">리뷰가 빠진 가게는 동반 가능 점수가 다시 계산됩니다.
      같은 이메일로는 30일간 재가입할 수 없습니다(약관 14조 5항). 이메일은 해시로만 보관합니다.</p>
    <p class="meta">이 작업은 사유와 함께 접속기록에 남습니다. 사유는 1년, 재가입 차단은 30일 보관됩니다.</p>
    <form method="post" action="/admin/users/{{userId}}/terminate" class="stack">
      <input type="hidden" name="{{csrfParameter}}" value="{{csrfToken}}">
      <label>해지 사유 <small>약관 12조 위반 내용. 200자 이내</small>
        <textarea name="reason" rows="3" maxlength="200" required></textarea>
      </label>
      <label>확인 <small>대상이 맞는지 확인하기 위해 닉네임 <code>{{nickname}}</code> 을 그대로 입력하세요</small>
        <input name="confirmNickname" autocomplete="off" maxlength="50" required>
      </label>
      <button type="submit" class="danger">이용계약 해지</button>
    </form>
  </details>
  {{/user}}
</main>
{{> admin/_foot}}
